# =============================================================================
# Mac Apple Silicon 환경 전용 환경 변수
# =============================================================================
#
# 사용법:
#   source .env.mac
#
# 또는 docker-compose 실행 시:
#   docker compose --env-file .env.mac -f docker-compose.mac.yml up -d
#
# =============================================================================

# --- Database Configuration ---
POSTGRES_USER=cellcraft_admin
POSTGRES_PASSWORD=cellcraft_admin
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cellcraft

# --- Docker Build Configuration (Mac 최적화) ---
# BuildKit 활성화 (필수: TARGETPLATFORM 인자 전달을 위해)
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# 기본 플랫폼 명시 (Apple Silicon)
DOCKER_DEFAULT_PLATFORM=linux/arm64

# Docker Compose 버전 2 사용
COMPOSE_DOCKER_CLI_BUILD=1

# --- Mac 환경 최적화 변수 ---
# macOS fork 안정성 향상 (multiprocessing 사용 시)
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Docker Desktop 리소스 제한 (선택 사항)
# 주석 해제하여 사용
# COMPOSE_PARALLEL_LIMIT=4
# COMPOSE_HTTP_TIMEOUT=120

# --- Application Configuration ---
# Timezone
TZ=Asia/Seoul

# CPU Only Mode (Mac에서는 NVIDIA GPU 미지원)
CPU_ONLY=true

# --- Development Settings ---
# 개발 모드 활성화 (선택)
# DEBUG=true
# LOG_LEVEL=debug

# --- Performance Tuning ---
# Volume mount 성능 최적화 (Docker Desktop VM 고려)
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_CONVERT_WINDOWS_PATHS=0

# =============================================================================
# 참고사항
# =============================================================================
#
# 1. Docker Desktop 권장 설정:
#    - Memory: 8GB 이상 할당
#    - CPUs: 4-6 cores 할당
#    - Disk image size: 60GB 이상
#    - File sharing: 프로젝트 디렉토리 추가
#
# 2. BuildKit 활성화 확인:
#    docker buildx version
#
# 3. 플랫폼 확인:
#    docker info | grep -i "Architecture"
#
# 4. 빌드 후 이미지 플랫폼 검증:
#    docker inspect cellcraft-backend | grep Architecture
#
# =============================================================================
