{
  "name": "FastSCODE",
  "rules": {
    "0": {
      "name": "FastSCODE Input",
      "input": [
        "input.h5ad",
        "geneList.txt"
      ],
      "output": [
        "expression.csv",
        "trajectory.txt",
        "cellSelect.txt"
      ],
      "script": "fastscode_input.py",
      "parameters": [
        {
          "name": "input",
          "type": "inputFile",
          "defaultValue": "input.h5ad",
          "min": null,
          "max": null,
          "fileExtension": ".h5ad"
        },
        {
          "name": "geneList",
          "type": "optionalInputFile",
          "defaultValue": "geneList.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "UMAP lasso",
          "type": "h5adParameter",
          "defaultValue": "",
          "min": null,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "expression",
          "type": "outputFile",
          "defaultValue": "expression.csv",
          "min": null,
          "max": null,
          "fileExtension": ".csv"
        },
        {
          "name": "trajectory",
          "type": "outputFile",
          "defaultValue": "trajectory.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "cellSelect",
          "type": "outputFile",
          "defaultValue": "cellSelect.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "cell group",
          "type": "h5adParameter",
          "defaultValue": "",
          "min": null,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "pseudotime",
          "type": "h5adParameter",
          "defaultValue": "",
          "min": null,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "clusters",
          "type": "h5adParameter",
          "defaultValue": "",
          "min": null,
          "max": null,
          "fileExtension": ""
        }
      ],
      "nodeId": 1,
      "isVisualization": false
    },
    "1": {
      "name": "Run",
      "input": [
        "expression.csv",
        "trajectory.txt",
        "cellSelect.txt"
      ],
      "output": [
        "GRN.sif",
        "GRNOutdegree.txt",
        "GRNTrim.sif",
        "GRNTrimOutdegree.txt"
      ],
      "script": "scode_for_cellcraft.py",
      "parameters": [
        {
          "name": "expression",
          "type": "inputFile",
          "defaultValue": "expression.csv",
          "min": null,
          "max": null,
          "fileExtension": ".csv"
        },
        {
          "name": "trajectory",
          "type": "inputFile",
          "defaultValue": "trajectory.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "cellSelect",
          "type": "inputFile",
          "defaultValue": "cellSelect.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "sampling length",
          "type": "int",
          "defaultValue": "10",
          "min": 1,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "max iteration",
          "type": "int",
          "defaultValue": "100",
          "min": 1,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "backend",
          "type": "string",
          "defaultValue": "gpu",
          "min": null,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "number of devices",
          "type": "int",
          "defaultValue": "1",
          "min": 1,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "sampling batch size",
          "type": "int",
          "defaultValue": "1",
          "min": 1,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "gene batch size",
          "type": "int",
          "defaultValue": "0",
          "min": 0,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "num repeat",
          "type": "int",
          "defaultValue": "1",
          "min": 1,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "number of outdegrees",
          "type": "int",
          "defaultValue": "1000",
          "min": 100,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "trim threshold",
          "type": "float",
          "defaultValue": "0.01",
          "min": null,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "GRN",
          "type": "outputFile",
          "defaultValue": "GRN.sif",
          "min": null,
          "max": null,
          "fileExtension": ".sif"
        },
        {
          "name": "GRNOutdegree",
          "type": "outputFile",
          "defaultValue": "GRNOutdegree.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "GRNTrim",
          "type": "outputFile",
          "defaultValue": "GRNTrim.sif",
          "min": null,
          "max": null,
          "fileExtension": ".sif"
        },
        {
          "name": "GRNTrimOutdegree",
          "type": "outputFile",
          "defaultValue": "GRNTrimOutdegree.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        }
      ],
      "nodeId": 2,
      "isVisualization": false
    }
  }
}