{
  "name": "TENET",
  "rules": {
    "0": {
      "name": "TENET Input",
      "input": [
        "input.h5ad",
        "geneList.txt"
      ],
      "output": [
        "expression.csv",
        "trajectory.txt",
        "cellSelect.txt"
      ],
      "script": "tenet_input.py",
      "parameters": [
        {
          "name": "input",
          "type": "inputFile",
          "defaultValue": "input.h5ad",
          "min": null,
          "max": null,
          "fileExtension": ".h5ad"
        },
        {
          "name": "geneList",
          "type": "optionalInputFile",
          "defaultValue": "geneList.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "UMAP lasso",
          "type": "h5adParameter",
          "defaultValue": "",
          "min": null,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "expression",
          "type": "outputFile",
          "defaultValue": "expression.csv",
          "min": null,
          "max": null,
          "fileExtension": ".csv"
        },
        {
          "name": "trajectory",
          "type": "outputFile",
          "defaultValue": "trajectory.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "cellSelect",
          "type": "outputFile",
          "defaultValue": "cellSelect.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "cell group",
          "type": "h5adParameter",
          "defaultValue": "",
          "min": null,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "pseudotime",
          "type": "h5adParameter",
          "defaultValue": "",
          "min": null,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "clusters",
          "type": "h5adParameter",
          "defaultValue": "",
          "min": null,
          "max": null,
          "fileExtension": ""
        }
      ],
      "nodeId": 1,
      "isVisualization": false
    },
    "1": {
      "name": "Run",
      "input": [
        "expression.csv",
        "trajectory.txt",
        "cellSelect.txt",
        "TF.txt"
      ],
      "output": [
        "resultMatrix.txt"
      ],
      "script": "tenet_for_cellcraft.py",
      "parameters": [
        {
          "name": "expression",
          "type": "inputFile",
          "defaultValue": "expression.csv",
          "min": null,
          "max": null,
          "fileExtension": ".csv"
        },
        {
          "name": "trajectory",
          "type": "inputFile",
          "defaultValue": "trajectory.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "cellSelect",
          "type": "inputFile",
          "defaultValue": "cellSelect.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "TF",
          "type": "optionalInputFile",
          "defaultValue": "TF.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "resultMatrix",
          "type": "outputFile",
          "defaultValue": "resultMatrix.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "number of devices",
          "type": "int",
          "defaultValue": "4",
          "min": 1,
          "max": null,
          "fileExtension": ""
        }
      ],
      "nodeId": 2,
      "isVisualization": false
    },
    "2": {
      "name": "GRN Reconstruction : FDR",
      "input": [
        "resultMatrix.txt"
      ],
      "output": [
        "Fdr.sif"
      ],
      "script": "makeGRN.py",
      "parameters": [
        {
          "name": "FDR",
          "type": "float",
          "defaultValue": "0.01",
          "min": 0,
          "max": 1,
          "fileExtension": ""
        },
        {
          "name": "resultMatrix",
          "type": "inputFile",
          "defaultValue": "resultMatrix.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "Fdr",
          "type": "outputFile",
          "defaultValue": "Fdr.sif",
          "min": null,
          "max": null,
          "fileExtension": ".sif"
        }
      ],
      "nodeId": 3,
      "isVisualization": false
    },
    "3": {
      "name": "GRN Reconstruction : NumLinks",
      "input": [
        "resultMatrix.txt"
      ],
      "output": [
        "Numlinks.sif"
      ],
      "script": "makeGRNsameNumberOfLinks.py",
      "parameters": [
        {
          "name": "number of outdegrees",
          "type": "int",
          "defaultValue": "1000",
          "min": 100,
          "max": null,
          "fileExtension": ""
        },
        {
          "name": "resultMatrix",
          "type": "inputFile",
          "defaultValue": "resultMatrix.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "Numlinks",
          "type": "outputFile",
          "defaultValue": "Numlinks.sif",
          "min": null,
          "max": null,
          "fileExtension": ".sif"
        }
      ],
      "nodeId": 4,
      "isVisualization": false
    },
    "4": {
      "name": "Indirect Edge Trimming",
      "input": [
        "Fdr.sif",
        "Numlinks.sif"
      ],
      "output": [
        "FdrTrim.sif",
        "NumlinksTrim.sif"
      ],
      "script": "trim_indirect.py",
      "parameters": [
        {
          "name": "Fdr",
          "type": "inputFile",
          "defaultValue": "Fdr.sif",
          "min": null,
          "max": null,
          "fileExtension": ".sif"
        },
        {
          "name": "Numlinks",
          "type": "inputFile",
          "defaultValue": "Numlinks.sif",
          "min": null,
          "max": null,
          "fileExtension": ".sif"
        },
        {
          "name": "FdrTrim",
          "type": "outputFile",
          "defaultValue": "FdrTrim.sif",
          "min": null,
          "max": null,
          "fileExtension": ".sif"
        },
        {
          "name": "NumlinksTrim",
          "type": "outputFile",
          "defaultValue": "NumlinksTrim.sif",
          "min": null,
          "max": null,
          "fileExtension": ".sif"
        },
        {
          "name": "trimming threshold",
          "type": "float",
          "defaultValue": "0",
          "min": null,
          "max": null,
          "fileExtension": ""
        }
      ],
      "nodeId": 5,
      "isVisualization": false
    },
    "5": {
      "name": "Counting Outdegree",
      "input": [
        "Fdr.sif",
        "Numlinks.sif",
        "FdrTrim.sif",
        "NumlinksTrim.sif"
      ],
      "output": [
        "FdrOutdegree.txt",
        "NumlinksOutdegree.txt",
        "FdrTrimOutdegree.txt",
        "NumlinksTrimOutdegree.txt"
      ],
      "script": "countOutdegree.py",
      "parameters": [
        {
          "name": "Fdr",
          "type": "inputFile",
          "defaultValue": "Fdr.sif",
          "min": null,
          "max": null,
          "fileExtension": ".sif"
        },
        {
          "name": "Numlinks",
          "type": "inputFile",
          "defaultValue": "Numlinks.sif",
          "min": null,
          "max": null,
          "fileExtension": ".sif"
        },
        {
          "name": "FdrTrim",
          "type": "inputFile",
          "defaultValue": "FdrTrim.sif",
          "min": null,
          "max": null,
          "fileExtension": ".sif"
        },
        {
          "name": "NumlinksTrim",
          "type": "inputFile",
          "defaultValue": "NumlinksTrim.sif",
          "min": null,
          "max": null,
          "fileExtension": ".sif"
        },
        {
          "name": "FdrOutdegree",
          "type": "outputFile",
          "defaultValue": "FdrOutdegree.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "NumlinksOutdegree",
          "type": "outputFile",
          "defaultValue": "NumlinksOutdegree.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "FdrTrimOutdegree",
          "type": "outputFile",
          "defaultValue": "FdrTrimOutdegree.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        },
        {
          "name": "NumlinksTrimOutdegree",
          "type": "outputFile",
          "defaultValue": "NumlinksTrimOutdegree.txt",
          "min": null,
          "max": null,
          "fileExtension": ".txt"
        }
      ],
      "nodeId": 6,
      "isVisualization": false
    }
  }
}