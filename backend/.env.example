# Local run outside docker compose (see backend/README.md): cp .env.example .env
# docker compose installs do not use this file; they read the repository root .env
# created by scripts/ensure-env.sh (or ./run-cpu-mode.sh / ./run-gpu-mode.sh).
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cellcraft

# Internal services (defaults: rabbitmq/redis service names, guest account, no Redis password)
RABBITMQ_HOST=localhost
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
REDIS_HOST=localhost
# REDIS_PASSWORD=
