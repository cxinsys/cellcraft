# Exclude heavy and transient runtime artifacts from build context
# to prevent tar errors (e.g., sockets/irregular files) and reduce context size.

# Snakemake and training logs (may contain sockets or large files)
.snakemake/
lightning_logs/

# Python caches and env files
__pycache__/
*.pyc
*.pyo
*.log
.env

# Common OS/editor artifacts
.DS_Store
Thumbs.db

# Node/R caches if present
node_modules/
npm-cache/
