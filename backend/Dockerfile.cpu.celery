# syntax=docker/dockerfile:1.4

# =============================================================================
# Multi-platform Build Support
# =============================================================================
# TARGETPLATFORM is automatically injected by Docker buildx during multi-platform builds.
# For docker-compose local builds, it can be passed via build args.
# When not specified, buildx automatically selects the correct platform.
# =============================================================================

# Build stage - 컴파일 도구 및 개발 의존성 설치
# Note: Omitting --platform lets buildx automatically select the correct platform
# for multi-platform builds (linux/amd64, linux/arm64)
FROM python:3.10-slim AS builder

# TARGETPLATFORM is auto-injected by buildx, declare to use within stage
ARG TARGETPLATFORM

# 필수 빌드 도구 설치
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Micromamba 설치 (플랫폼별 아키텍처 자동 감지)
ENV MAMBA_ROOT_PREFIX=/opt/micromamba
ENV PATH=${MAMBA_ROOT_PREFIX}/bin:$PATH

# Detect platform: use TARGETPLATFORM if set, otherwise detect from system
RUN PLATFORM=${TARGETPLATFORM:-$(uname -m | sed 's/x86_64/linux\/amd64/' | sed 's/aarch64/linux\/arm64/')} && \
    case $PLATFORM in \
        "linux/amd64")  \
            MICROMAMBA_ARCH=linux-64 && \
            CONDA_SUBDIR=linux-64 ;; \
        "linux/arm64")  \
            MICROMAMBA_ARCH=linux-aarch64 && \
            CONDA_SUBDIR=linux-aarch64 ;; \
        *) \
            MICROMAMBA_ARCH=linux-64 && \
            CONDA_SUBDIR=linux-64 ;; \
    esac && \
    echo "Installing micromamba for $MICROMAMBA_ARCH" && \
    echo "Setting CONDA_SUBDIR to $CONDA_SUBDIR" && \
    curl -L "https://micromamba.snakepit.net/api/micromamba/$MICROMAMBA_ARCH/latest" | \
    tar -xvj -C /usr/local/bin/ --strip-components=1 bin/micromamba && \
    export CONDA_SUBDIR=$CONDA_SUBDIR

# Conda 환경 구성 (CPU 전용 환경 파일 사용 + 플랫폼별 패키지)
COPY environment.yml ./
RUN PLATFORM=${TARGETPLATFORM:-$(uname -m | sed 's/x86_64/linux\/amd64/' | sed 's/aarch64/linux\/arm64/')} && \
    case $PLATFORM in \
        "linux/amd64")  export CONDA_SUBDIR=linux-64 ;; \
        "linux/arm64")  export CONDA_SUBDIR=linux-aarch64 ;; \
        *)              export CONDA_SUBDIR=linux-64 ;; \
    esac && \
    echo "Creating conda environment with CONDA_SUBDIR=$CONDA_SUBDIR" && \
    micromamba config set channel_priority flexible && \
    CONDA_SUBDIR=$CONDA_SUBDIR micromamba create -y -n snakemake -f environment.yml --platform $CONDA_SUBDIR || \
    (echo "Retrying with relaxed dependencies..." && \
     CONDA_SUBDIR=$CONDA_SUBDIR micromamba create -y -n snakemake python=3.10 -c conda-forge -c bioconda && \
     CONDA_SUBDIR=$CONDA_SUBDIR micromamba install -y -n snakemake -f environment.yml --freeze-installed || true)

# Runtime stage - 최소 런타임 환경
# Note: buildx automatically selects the matching platform for this FROM
# This ensures builder and runtime stages use the same architecture
FROM python:3.10-slim

# 런타임 패키지만 설치 (Java 의존성 제거)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Micromamba와 환경을 빌드 스테이지에서 복사
ENV MAMBA_ROOT_PREFIX=/opt/micromamba
ENV PATH=${MAMBA_ROOT_PREFIX}/bin:$PATH
COPY --from=builder /usr/local/bin/micromamba /usr/local/bin/micromamba
COPY --from=builder /opt/micromamba /opt/micromamba

# Micromamba 환경 PATH 등록
ENV PATH=/opt/micromamba/envs/snakemake/bin:$PATH
ENV CONDA_DEFAULT_ENV=snakemake


# 작업 디렉토리 설정 및 코드 복사
WORKDIR /app
COPY . .

# Note: Git submodules are managed on the host and mounted via volumes
# This ensures proper branch synchronization between host and container

# Celery 실행
CMD ["/opt/micromamba/envs/snakemake/bin/python", "-m", "celery", "-A", "app.main.celery", "worker", "-n", "worker@%h", "--loglevel=info", "-E", "-Q", "workflow_task,plugin_task"]
